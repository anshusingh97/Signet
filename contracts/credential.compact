// Signet — prove a credential is valid without disclosing it
// Midnight Builder Challenge — Level 3 (First Quarter)
// Idea: Confidential Credentials
//
// PRIVACY MODEL
//   PUBLIC   : gate metadata (resource name, minimum required tier),
//              the count of successful verifications, the set of spent
//              nullifiers, gate open/closed status.
//   PRIVATE  : the credential secret, the holder's exact tier, and any
//              link between a nullifier and the identity that presented it.
//   PROVED WITHOUT REVEALING: that the caller holds a credential issued
//              by the trusted issuer, at or above the gate's required
//              tier, and has not presented it to this gate before —
//              without revealing the credential's serial, its exact
//              tier, or who the holder is.

pragma language_version >= 0.16;

import CompactStandardLibrary;

// ---------------------------------------------------------------------
// Ledger (PUBLIC on-chain state)
// ---------------------------------------------------------------------

export ledger resourceName: Opaque<"string">;
export ledger requiredTier: Uint<8>;
export ledger issuerRoot: Bytes<32>;      // Merkle root of issued credential leaves
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger verifiedCount: Counter;
export ledger gateOpen: Boolean;

// ---------------------------------------------------------------------
// Witnesses (PRIVATE — supplied locally by the credential holder)
// ---------------------------------------------------------------------

witness credentialSecret(): Bytes<32>;
witness credentialTier(): Uint<8>;
witness credentialPath(): MerkleTreePath<10, Bytes<32>>;

// ---------------------------------------------------------------------
// Circuits
// ---------------------------------------------------------------------

// Issuer / resource owner opens a gate: names the protected resource,
// sets the minimum tier a credential must carry, and publishes the
// Merkle root of every (secret, tier) leaf it has issued.
export circuit openGate(
  name: Opaque<"string">,
  minTier: Uint<8>,
  root: Bytes<32>
): [] {
  resourceName = name;
  requiredTier = minTier;
  issuerRoot = root;
  gateOpen = true;
  verifiedCount = default<Counter>;
}

// A holder proves, in zero-knowledge:
//   1) they know (secret, tier) such that hash(secret, tier) is a leaf
//      of issuerRoot — i.e. the issuer actually issued this credential
//   2) tier >= requiredTier — WITHOUT revealing tier itself
//   3) the nullifier derived from secret + resourceName hasn't been
//      spent before at this gate
// Only the aggregate `verifiedCount` changes on-chain. No credential
// serial, exact tier, or holder identity is ever written to the ledger.
export circuit presentCredential(): [] {
  assert(gateOpen, "gate is closed");

  const secret = credentialSecret();
  const tier = credentialTier();
  const path = credentialPath();

  assert(tier >= requiredTier, "credential tier is below the gate's requirement");

  const leaf = persistentHash<Vector<2, Bytes<32>>>(
    [secret, persistentHash<Uint<8>>(tier)]
  );
  const computedRoot = merkleTreePathRoot<10, Bytes<32>>(path, leaf);
  assert(computedRoot == issuerRoot, "credential was not issued by the trusted issuer");

  const nullifier = persistentHash<Vector<2, Bytes<32>>>(
    [secret, persistentHash<Opaque<"string">>(resourceName)]
  );
  assert(!usedNullifiers.member(nullifier), "credential already presented at this gate");
  usedNullifiers.insert(nullifier);

  verifiedCount.increment(1);
}

// Issuer closes the gate. Past verifications remain valid and counted;
// no further credentials may be presented.
export circuit closeGate(): [] {
  assert(gateOpen, "already closed");
  gateOpen = false;
}
